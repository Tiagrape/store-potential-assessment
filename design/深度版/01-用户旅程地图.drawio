<mxfile host="app.diagrams.net" agent="drawio" version="24.0.0"><diagram id="d" name="Page-1"><mxGraphModel dx="1400" dy="390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="企业运营 用户旅程地图 —— 从&quot;想提升覆盖率&quot;到&quot;验证投放效果&quot;" style="text;html=1;fontColor=#0a5e53;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="st0" value="发现高潜门店" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="260" height="40" as="geometry"/></mxCell><mxCell id="st1" value="查看门店画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="260" height="40" as="geometry"/></mxCell><mxCell id="st2" value="圈选与投放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="260" height="40" as="geometry"/></mxCell><mxCell id="st3" value="销售执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;" vertex="1" parent="1"><mxGeometry x="870" y="50" width="260" height="40" as="geometry"/></mxCell><mxCell id="st4" value="效果验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;" vertex="1" parent="1"><mxGeometry x="1140" y="50" width="260" height="40" as="geometry"/></mxCell><mxCell id="lane_b" value="用户行为" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1380" height="60" as="geometry"/></mxCell><mxCell id="a0" value="在后台查看本企业高潜门店列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8f3ec;strokeColor=#0c7a6b;fontColor=#0a5e53;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="a1" value="点开单店看潜力分与五维雷达图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8f3ec;strokeColor=#0c7a6b;fontColor=#0a5e53;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="a2" value="用「高潜待突破」圈选门店、看覆盖预估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8f3ec;strokeColor=#0c7a6b;fontColor=#0a5e53;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="a3" value="业务员按画像推荐动作拜访" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8f3ec;strokeColor=#0c7a6b;fontColor=#0a5e53;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="a4" value="后台看效果回溯：渗透提升/误命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8f3ec;strokeColor=#0c7a6b;fontColor=#0a5e53;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="lane_e" value="情绪与体验" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1380" height="60" as="geometry"/></mxCell><mxCell id="e0" value="困惑：门店太多不知从哪入手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="260" height="40" as="geometry"/></mxCell><mxCell id="e1" value="眼前一亮：分数可解释、有依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="260" height="40" as="geometry"/></mxCell><mxCell id="e2" value="放心：投放前能预估价值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="260" height="40" as="geometry"/></mxCell><mxCell id="e3" value="高效：动作具体可执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="870" y="180" width="260" height="40" as="geometry"/></mxCell><mxCell id="e4" value="信任：效果可量化可追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="1140" y="180" width="260" height="40" as="geometry"/></mxCell><mxCell id="lane_p" value="痛点与机会点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#13232d;strokeColor=#13232d;fontColor=#eef6f7;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1380" height="60" as="geometry"/></mxCell><mxCell id="p0" value="痛点：依赖销售经验、无数据依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdc9d3;fontColor=#14212b;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="p1" value="机会：可解释分数+雷达图+驱动维度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdc9d3;fontColor=#14212b;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="p2" value="痛点：盲目投放风险高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdc9d3;fontColor=#14212b;" vertex="1" parent="1"><mxGeometry x="600" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="p3" value="机会：模拟圈选先算账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdc9d3;fontColor=#14212b;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="p4" value="机会：效果回流形成闭环、持续优化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdc9d3;fontColor=#14212b;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="note" value="洞察：用户核心诉求是&quot;投得准、看得懂、能验证&quot;。产品抓手 = 可解释评分 + 投放前模拟 + 效果闭环。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff7ec;strokeColor=#e98a15;fontColor=#9a5600;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="1320" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>